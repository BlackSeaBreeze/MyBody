# Копируйте в .env и подставьте свои значения. Файл .env не коммитится в git.
# Garmin Connect (для /garmin/*)
# GARMIN_EMAIL=your@email.com
# GARMIN_PASSWORD=your_password

# Gemini API (для /garmin/analyze). Ключ: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_api_key

# Опционально: секрет для вызова /internal/garmin-fetch по расписанию
# CRON_SECRET=your_cron_secret
